.venv/
.venv-sim/
__pycache__/
*.pyc
.pytest_cache/
runs/
checkpoints/
# Ignore the contents rather than the directory itself: git will not re-include
# anything inside a directory it has already excluded, so `artifacts/` here made
# the negation below silently do nothing.
artifacts/*
# ...except the verification results. These are small, they are the evidence
# behind the numbers in the packets, and a claim whose supporting run is not in
# the repository cannot be checked. Four completed probe sweeps were lost once
# because their output lived only outside it.
!artifacts/verification/
data/processed/
*.egg-info/
dist/
build/
desktop/node_modules/
desktop/dist/
desktop/release/
desktop/python-dist/
*.tsbuildinfo

# Local Modal/torch shim (pure-Python deps live here; install via requirements on remote)
pylibs/

# Generated OpenRocket hardware corpus binaries (keep JSON manifests)
data/openrocket_hardware_8k/**/*.stl
data/openrocket_hardware_8k/**/*.ork

# Oversized external downloads (GitHub 100MB limit)
data/raw_downloads/external/jaxa_ryugu/SHAPE_SFM_3M_v20180804.csv
data/raw_downloads/external/jaxa_ryugu/SHAPE_SFM_3M_v20180804.obj

# Accidental CalculiX CLI dumps
-help.cvg
-help.dat
-help.sta

# /goal harness runtime state (keep hooks/skills/commands)
.cursor/goal/

# Host-local solver stack, extracted from .debs (see env.sh). ~375MB of
# binaries; rebuildable from colab/solver-env.tar.gz, so not tracked.
solver-env/
colab/solver-env.tar.gz

# Environment captured from the decommissioned VM (apt/pip manifests,
# dotfiles, git state). Reference material, not source.
_vm_environment/
